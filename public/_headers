# Cloudflare Pages headers.
# HTML, CSS, JS and config: always revalidate, so edits show right after a deploy (no stale numbers/text).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(self), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com/beacon.min.js; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://cloudflareinsights.com; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  Cache-Control: no-cache

/admin/*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

# Logos and images rarely change: cache for a week.
/images/*
  Cache-Control: public, max-age=604800
/favicon.svg
  Cache-Control: public, max-age=604800
