{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arif-studio",
  "main": "worker.js",
  "compatibility_date": "2026-10-31",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "arif-studio-products",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "arif-studio-product-images"
    }
  ]
}
